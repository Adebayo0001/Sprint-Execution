rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Sprint Leads Validation
    function isValidLead(data) {
      return data.keys().hasAll(['full_name', 'email', 'whatsapp', 'state', 'country', 'goal', 'support_level', 'created_at'])
        && data.full_name is string && data.full_name.size() > 0
        && data.created_at == request.time;
    }

    match /sprint_leads/{leadId} {
      allow create: if isValidLead(incoming());
      allow read, update, delete: if false;
    }

    match /public_feed/{feedId} {
      allow read: if true;
      allow create: if incoming().created_at == request.time;
    }

    match /global_stats/registration_count {
      // Public read for live dashboard social proof
      allow read: if true;
      // Allow atomic increments during registration
      allow create: if incoming().count == 1;
      allow update: if incoming().count == existing().count + 1;
    }
  }
}
