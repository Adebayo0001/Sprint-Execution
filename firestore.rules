rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Sprint Leads Validation
    function isValidLead(data) {
      return data.keys().hasAll(['full_name', 'email', 'whatsapp', 'state', 'country', 'goal', 'support_level', 'created_at'])
        && data.keys().size() >= 8 && data.keys().size() <= 9
        && data.full_name is string && data.full_name.size() > 0
        && data.state is string && data.state.size() > 0
        && data.country is string && data.country.size() > 0
        && data.whatsapp is string && data.whatsapp.size() > 0
        && data.support_level in ['group_only', 'group_plus_support']
        && data.created_at == request.time;
    }

    match /sprint_leads/{leadId} {
      allow create: if isValidLead(incoming());
      allow read, update, delete: if false;
    }

    match /public_feed/{feedId} {
      // Public read for real-time notifications
      allow read: if true;
      // Protected creation logic
      allow create: if (
        incoming().keys().hasAll(['name', 'state', 'country', 'tier', 'created_at']) &&
        incoming().name is string &&
        incoming().state is string &&
        incoming().country is string &&
        incoming().tier is string &&
        incoming().created_at == request.time
      );
    }

    match /global_stats/registration_count {
      // Public read for live dashboard social proof
      allow read: if true;
      // Allow atomic increments during registration
      allow create: if incoming().count == 1;
      allow update: if incoming().count == existing().count + 1;
    }
  }
}
